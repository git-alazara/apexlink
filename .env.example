# Apex Link environment
# Copy to .env for local development. Do not commit real secrets.

NEXT_PUBLIC_SITE_DOMAIN=buyapexlink.com
NEXT_PUBLIC_SITE_URL=https://buyapexlink.com

# Pricing defaults: $10 starting price, +$1 per confirmed purchase
INITIAL_PRICE_CENTS=1000
PRICE_INCREMENT_CENTS=100

# Local Docker Compose or Kubernetes service URL
POSTGRES_PASSWORD=dev_postgres_change_in_production
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/apexlink

# Stripe
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
